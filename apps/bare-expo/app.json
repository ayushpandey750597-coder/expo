    import React, { useEffect, useState } from "react";
import { View, Text, TextInput, TouchableOpacity, ActivityIndicator, Alert, StyleSheet } from "react-native";
import { NavigationContainer } from "@react-navigation/native";
import { createNativeStackNavigator } from "@react-navigation/native-stack";
import { createBottomTabNavigator } from "@react-navigation/bottom-tabs";
import AsyncStorage from "@react-native-async-storage/async-storage";
import { LinearGradient } from "expo-linear-gradient";
import { Ionicons } from "@expo/vector-icons";

const Stack = createNativeStackNavigator();
const Tab = createBottomTabNavigator();

/* Gradient Button */
const GradientButton = ({ title, onPress, colors = ["#4facfe", "#00f2fe"] }) => (
  <TouchableOpacity onPress={onPress} activeOpacity={0.9} style={{ width: "100%" }}>
    <LinearGradient colors={colors} style={styles.gradientBtn}>
      <Text style={styles.gradientBtnText}>{title}</Text>
    </LinearGradient>
  </TouchableOpacity>
);

/* Card */
const Card = ({ children, style }) => (
  <View style={[styles.card, style]}>{children}</View>
);

/* Splash Screen */
const Splash = () => (
  <LinearGradient colors={["#00c6ff", "#0072ff"]} style={styles.splash}>
    <Ionicons name="book" size={90} color="#fff" style={{ marginBottom: 16 }} />
    <Text style={styles.splashTitle}>My Learning App</Text>
    <ActivityIndicator size="large" color="#fff" style={{ marginTop: 18 }} />
  </LinearGradient>
);

/* Onboarding */
const Onboarding = ({ navigation }) => {
  return (
    <LinearGradient colors={["#ff6a00", "#ee0979"]} style={styles.onboarding}>
      <Ionicons name="rocket" size={150} color="#fff" style={{ marginBottom: 18 }} />
      <Text style={styles.onboardingTitle}>Welcome to My Learning App</Text>
      <Text style={styles.onboardingSub}>
        Learn anytime, anywhere. Start your journey with us today!
      </Text>
      <TouchableOpacity
        onPress={() => navigation.replace("Login")}
        style={styles.onboardingCTA}
        activeOpacity={0.9}
      >
        <Text style={styles.onboardingCTAText}>Get Started →</Text>
      </TouchableOpacity>
    </LinearGradient>
  );
};

/* Login (OTP = 1234) */
const Login = ({ navigation, setIsLoggedIn }) => {
  const [phone, setPhone] = useState("");
  const [otp, setOtp] = useState("");
  const [step, setStep] = useState(1);
  const [name, setName] = useState("");

  const handleSendOtp = async () => {
    if (name.trim().length === 0) {
      Alert.alert("Invalid Name", "Please enter your name.");
      return;
    }
    if (phone.length < 10) {
      Alert.alert("Invalid Number", "Please enter a valid phone number.");
      return;
    }
    await AsyncStorage.setItem("phone", phone);
    await AsyncStorage.setItem("name", name);
    Alert.alert("OTP Sent", "Use 1234 as test OTP.");
    setStep(2);
  };

  const handleVerifyOtp = async () => {
    if (otp !== "1234") {
      Alert.alert("Invalid OTP", "Please enter the correct OTP (1234).");
      return;
    }
    await AsyncStorage.setItem("isLoggedIn", "true");
    setIsLoggedIn(true);
    navigation.replace("Main");
  };

  return (
    <Card style={{ padding: 20, width: "100%" }}>
      <Text style={styles.header}>Login with OTP</Text>
      {step === 1 ? (
        <>
          <TextInput
            style={styles.input}
            placeholder="Enter Name"
            value={name}
            onChangeText={setName}
          />
          <TextInput
            style={styles.input}
            placeholder="Enter Phone"
            keyboardType="phone-pad"
            value={phone}
            onChangeText={setPhone}
          />
          <GradientButton title="Send OTP" onPress={handleSendOtp} />
        </>
      ) : (
        <>
          <TextInput
            style={styles.input}
            placeholder="Enter OTP"
            keyboardType="numeric"
            value={otp}
            onChangeText={setOtp}
          />
          <GradientButton title="Verify OTP" onPress={handleVerifyOtp} />
        </>
      )}
    </Card>
  );
};

/* Profile */
const Profile = ({ navigation }) => {
  const [phone, setPhone] = useState("");
  const [name, setName] = useState("");

  const handleLogout = async () => {
    await AsyncStorage.multiRemove(["isLoggedIn", "phone", "name"]);
    navigation.replace("Onboarding");
  };

  useEffect(() => {
    const loadProfile = async () => {
      const savedPhone = await AsyncStorage.getItem("phone");
      const savedName = await AsyncStorage.getItem("name");
      if (savedPhone) setPhone(savedPhone);
      if (savedName) setName(savedName);
    };
    loadProfile();
  }, []);

  return (
    <Card style={{ width: "100%", padding: 20 }}>
      <Text style={styles.header}>Profile</Text>
      <Text>👤 Name: {name || "Not Available"}</Text>
      <Text>📱 Phone: {phone || "Not Available"}</Text>
      <GradientButton
        title="Logout"
        onPress={handleLogout}
        colors={["#ff4b2b", "#ff416c"]}
      />
    </Card>
  );
};

/* Home */
const Home = ({ navigation }) => {
  const [name, setName] = useState("");
  useEffect(() => {
    const loadName = async () => {
      const savedName = await AsyncStorage.getItem("name");
      if (savedName) setName(savedName);
    };
    loadName();
  }, []);

  const ActionCard = ({ title, screen }) => (
    <TouchableOpacity
      onPress={() => navigation.navigate(screen)}
      style={styles.actionCard}
      activeOpacity={0.9}
    >
      <Text style={{ fontSize: 16, fontWeight: "600" }}>{title}</Text>
    </TouchableOpacity>
  );

  return (
    <LinearGradient colors={["#4facfe", "#00f2fe"]} style={{ flex: 1, padding: 20 }}>
      <Text style={{ fontSize: 24, fontWeight: "bold", color: "#fff", marginTop: 40 }}>
        👋 Welcome {name || "User"}!
      </Text>
      <View style={{ flexDirection: "row", marginTop: 40 }}>
        <ActionCard title="Courses" screen="Courses" />
        <ActionCard title="Practice" screen="Practice" />
      </View>
      <View style={{ flexDirection: "row" }}>
        <ActionCard title="Tests" screen="Tests" />
        <ActionCard title="Profile" screen="Profile" />
      </View>
    </LinearGradient>
  );
};

/* Simple Screens */
const Courses = () => (
  <LinearGradient colors={["#43cea2", "#185a9d"]} style={styles.screenCenter}>
    <Text style={{ color: "#fff", fontSize: 22 }}>📚 Courses</Text>
  </LinearGradient>
);
const Practice = () => (
  <LinearGradient colors={["#ff9966", "#ff5e62"]} style={styles.screenCenter}>
    <Text style={{ color: "#fff", fontSize: 22 }}>✏️ Practice</Text>
  </LinearGradient>
);
const Tests = () => (
  <LinearGradient colors={["#8e2de2", "#4a00e0"]} style={styles.screenCenter}>
    <Text style={{ color: "#fff", fontSize: 22 }}>📝 Tests</Text>
  </LinearGradient>
);

/* Bottom Tabs */
function MainTabs() {
  return (
    <Tab.Navigator screenOptions={{ headerShown: false }}>
      <Tab.Screen name="Home" component={Home} />
      <Tab.Screen name="Courses" component={Courses} />
      <Tab.Screen name="Practice" component={Practice} />
      <Tab.Screen name="Tests" component={Tests} />
      <Tab.Screen name="Profile" component={Profile} />
    </Tab.Navigator>
  );
}

/* Root App */
export default function App() {
  const [isLoading, setIsLoading] = useState(true);
  const [isLoggedIn, setIsLoggedIn] = useState(false);

  useEffect(() => {
    const checkLogin = async () => {
      const storedLogin = await AsyncStorage.getItem("isLoggedIn");
      if (storedLogin === "true") setIsLoggedIn(true);
      setTimeout(() => setIsLoading(false), 800);
    };
    checkLogin();
  }, []);

  if (isLoading) return <Splash />;

  return (
    <NavigationContainer>
      <Stack.Navigator screenOptions={{ headerShown: false }}>
        {!isLoggedIn ? (
          <>
            <Stack.Screen name="Onboarding" component={Onboarding} />
            <Stack.Screen name="Login">
              {(props) => <Login {...props} setIsLoggedIn={setIsLoggedIn} />}
            </Stack.Screen>
          </>
        ) : null}
        <Stack.Screen name="Main" component={MainTabs} />
      </Stack.Navigator>
    </NavigationContainer>
  );
}

